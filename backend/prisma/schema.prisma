generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

model Pabrik {
  id          Int               @id @default(autoincrement())
  nama_pabrik String
  kode_pabrik String?
  work_orders WorkOrder[]
  rekomendasi Rekomendasi[]
  DailyTask   DailyTask[]
  FieldTask   FieldTask[]
  pdm_rules   PdmScheduleRule[]

  @@schema("public")
}

model User {
  id           Int       @id @default(autoincrement())
  npk          String    @unique
  password     String
  name         String
  role         String    @default("staff")
  is_online    Boolean   @default(false)
  last_active  DateTime? @default(now())
  man_power_id Int?      @unique
  man_power    ManPower? @relation(fields: [man_power_id], references: [id])

  created_plans ManpowerPlan[]
  approvals     ManpowerPlanApproval[]
  audits        ManpowerPlanAudit[]

  // WPEM relations
  wp_created      WorkProgram[]      @relation("WPCreatedBy")
  wp_audits       WorkProgramAudit[] @relation("WPAudits")
  item_activities WorkItemActivity[] @relation("ActivityActor")
  item_reviews    WorkItemReview[]   @relation("ItemReviewer")
  DailyTask       DailyTask[]
  field_tasks_created FieldTask[]

  // Chat relations
  sent_messages     ChatMessage[] @relation("SentMessages")
  received_messages ChatMessage[] @relation("ReceivedMessages")

  @@map("app_users")
  @@schema("public")
}

model Divisi {
  id              Int        @id
  nama_divisi     String
  work_center_sap String?
  man_power       ManPower[]

  @@schema("public")
}

model ManPower {
  id            Int                  @id @default(autoincrement())
  npk           String               @unique
  name          String
  employee_type String
  division_id   Int
  divisi        Divisi               @relation(fields: [division_id], references: [id])
  position      String
  sub_area      String? // Area kerja spesifik (contoh: "P6 PPHS & OSBL", "P6 Utility & Urea")
  is_active     Boolean              @default(true)
  absensi       StatusKehadiran[]
  user          User?
  plan_members  ManpowerPlanMember[]
  sertifikasi   Sertifikasi[]

  // WPEM relations
  wp_coordinating  WorkProgram[]         @relation("WPCoordinator")
  wp_memberships   WorkProgramMember[]   @relation("WPMembers")
  wp_approvals     WorkProgramApproval[] @relation("WPApprovals")
  wi_pic           WorkItem[]            @relation("WorkItemPIC")
  wi_plt           WorkItem[]            @relation("WorkItemPLT")
  wi_checklist_pic WorkItemChecklist[]   @relation("ChecklistPIC")
  DailyTask        DailyTask[]
  TaskLog          TaskLog[]
  field_tasks_pic     FieldTask[] @relation("FieldTaskPIC")
  field_task_members  FieldTaskMember[]
  field_task_logs     FieldTaskLog[]

  // PdM Rotating relations
  pdm_default_pic       PdmScheduleRule[]       @relation("RuleDefaultPic")
  pdm_monthly_pic       PdmRuleMonthlyPic[]     @relation("MonthlyPicOverride")
  pdm_assigned_tasks    PdmScheduleOccurrence[] @relation("AssignedTo")
  pdm_as_dc             PdmScheduleOccurrence[] @relation("OccurrenceDC")
  pdm_as_analyst        PdmScheduleOccurrence[] @relation("OccurrenceAnalyst")
  pdm_as_avp            PdmScheduleOccurrence[] @relation("OccurrenceAVP")
  pdm_pic_history_from  PdmPicHistory[]         @relation("PicHistoryFrom")
  pdm_pic_history_to    PdmPicHistory[]         @relation("PicHistoryTo")
  pdm_pic_history_by    PdmPicHistory[]         @relation("PicHistoryChangedBy")
  pdm_daily_activities  PdmDailyActivity[]      @relation("DailyActivityPerformer")
  pdm_workflow_logs     PdmWorkflowLog[]        @relation("WorkflowLogActor")
  pdm_delegations_given PdmCrossDelegation[]    @relation("DelegationGranter")
  pdm_delegations_recv  PdmCrossDelegation[]    @relation("DelegationReceiver")
  PdmOccurrenceHelper   PdmOccurrenceHelper[]

  @@schema("public")
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  senderId   Int
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId Int
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@schema("public")
}

model WorkOrder {
  id                 Int       @id @default(autoincrement())
  nomor_wo           String
  operation_activity String
  description        String?
  tanggal_dibuat     DateTime?
  status             String
  tipe_pm            String
  pabrik_id          Int
  pabrik             Pabrik    @relation(fields: [pabrik_id], references: [id])
  work_center        String?
  equipment          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([nomor_wo, operation_activity])
  @@schema("public")
}

model Rekomendasi {
  id                Int       @id @default(autoincrement())
  notification      String
  notification_type String?
  created_on        DateTime?
  order             String?
  equipment         String?
  description       String?
  reported_by       String?
  functional_loc    String?
  work_center       String?
  pabrik_id         Int
  pabrik            Pabrik    @relation(fields: [pabrik_id], references: [id])
  status            String?   @default("Diajukan")
  user_status       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([notification, reported_by], name: "notification_reported_by")
  @@schema("public")
}

model StatusKehadiran {
  id              Int      @id @default(autoincrement())
  man_power_id    Int
  man_power       ManPower @relation(fields: [man_power_id], references: [id])
  tanggal_mulai   DateTime
  tanggal_selesai DateTime
  jenis           String
  keterangan      String?

  @@schema("public")
}

model HariLibur {
  id         Int      @id @default(autoincrement())
  tanggal    DateTime @unique
  nama_libur String
  sumber     String   @default("Otomatis")

  @@schema("public")
}

model ManpowerPlan {
  id          Int      @id @default(autoincrement())
  title       String
  startDate   DateTime
  endDate     DateTime
  department  String
  area        String
  status      String   @default("Draft")
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members   ManpowerPlanMember[]
  approvals ManpowerPlanApproval[]
  audits    ManpowerPlanAudit[]

  @@schema("public")
}

model ManpowerPlanMember {
  id         Int          @id @default(autoincrement())
  planId     Int
  plan       ManpowerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  manPowerId Int
  manPower   ManPower     @relation(fields: [manPowerId], references: [id])
  role       String?
  notes      String?

  @@schema("public")
}

model ManpowerPlanApproval {
  id         Int          @id @default(autoincrement())
  planId     Int
  plan       ManpowerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  approverId Int
  approver   User         @relation(fields: [approverId], references: [id])
  role       String // "AVP" or "VP"
  status     String       @default("Pending") // Pending, Approved, Rejected, Revision
  notes      String?
  actionDate DateTime?

  @@schema("public")
}

model ManpowerPlanAudit {
  id        Int          @id @default(autoincrement())
  planId    Int
  plan      ManpowerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  action    String // Created, Submitted, Approved, Rejected, Revision, Bypass, Cancelled
  details   String?
  createdAt DateTime     @default(now())

  @@schema("public")
}

// ============================================================
// WPEM — Workforce Planning & Execution Management
// ============================================================

model WorkProgram {
  id                 Int       @id @default(autoincrement())
  title              String
  plant              String?
  area               String?
  work_package       String?
  department         String?
  start_date         DateTime
  end_date           DateTime
  estimated_duration Int? // in days
  priority           String    @default("Normal") // Low | Normal | High | Urgent
  status             String    @default("Draft")
  // Draft | Waiting AVP Approval | Waiting VP Approval | Approved | Team Ready | Active | Completed | Rejected | Revision Requested | Cancelled
  is_urgent_bypass   Boolean   @default(false)
  bypass_reason      String?
  notes              String?
  created_by_id      Int
  created_by         User      @relation("WPCreatedBy", fields: [created_by_id], references: [id])
  coordinator_id     Int?
  coordinator        ManPower? @relation("WPCoordinator", fields: [coordinator_id], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  members   WorkProgramMember[]
  approvals WorkProgramApproval[]
  audits    WorkProgramAudit[]
  items     WorkItem[]

  @@schema("public")
}

model WorkProgramMember {
  id           Int         @id @default(autoincrement())
  program_id   Int
  program      WorkProgram @relation(fields: [program_id], references: [id], onDelete: Cascade)
  man_power_id Int
  man_power    ManPower    @relation("WPMembers", fields: [man_power_id], references: [id])
  role         String? // Coordinator, Member, etc.
  joined_at    DateTime    @default(now())

  @@unique([program_id, man_power_id])
  @@schema("public")
}

model WorkProgramApproval {
  id             Int         @id @default(autoincrement())
  program_id     Int
  program        WorkProgram @relation(fields: [program_id], references: [id], onDelete: Cascade)
  approver_mp_id Int // points to ManPower (position = AVP*/VP)
  approver       ManPower    @relation("WPApprovals", fields: [approver_mp_id], references: [id])
  level          String // AVP | VP
  status         String      @default("Pending") // Pending | Approved | Rejected | Revision
  notes          String?
  action_date    DateTime?
  order_seq      Int         @default(0) // 0=AVP, 1=VP

  @@schema("public")
}

model WorkProgramAudit {
  id         Int         @id @default(autoincrement())
  program_id Int
  program    WorkProgram @relation(fields: [program_id], references: [id], onDelete: Cascade)
  actor_id   Int? // User who performed action
  actor      User?       @relation("WPAudits", fields: [actor_id], references: [id])
  action     String // Created | Submitted | Approved | Rejected | Revision | Bypassed | TeamFormed | Cancelled
  details    String?
  createdAt  DateTime    @default(now())

  @@schema("public")
}

model WorkItem {
  id                 Int         @id @default(autoincrement())
  program_id         Int
  program            WorkProgram @relation(fields: [program_id], references: [id], onDelete: Cascade)
  item_no            String? // e.g. "701", "702"
  title              String
  equipment          String?
  description        String?
  pic_id             Int? // PIC from ManPower
  pic                ManPower?   @relation("WorkItemPIC", fields: [pic_id], references: [id])
  plt_id             Int? // Temporary substitute PIC
  plt                ManPower?   @relation("WorkItemPLT", fields: [plt_id], references: [id])
  helpers            Json? // JSON array of man_power_id
  estimated_duration Int? // Estimasi Kerja dalam Hari (Days)
  priority           String      @default("Normal") // Low | Normal | High | Urgent
  status             String      @default("Waiting")
  // Waiting | In Progress | Ready For Review | Done | Hold
  progress_pct       Int         @default(0)
  started_at         DateTime?
  completed_at       DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  activities WorkItemActivity[]
  checklists WorkItemChecklist[]
  reviews    WorkItemReview[]

  @@schema("public")
}

model WorkItemActivity {
  id          Int      @id @default(autoincrement())
  item_id     Int
  item        WorkItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  actor_id    Int?
  actor       User?    @relation("ActivityActor", fields: [actor_id], references: [id])
  description String
  attachments Json? // array of { type: 'image'|'video'|'document', url: string, name: string }
  logged_at   DateTime @default(now())

  @@schema("public")
}

model WorkItemChecklist {
  id           Int       @id @default(autoincrement())
  item_id      Int
  item         WorkItem  @relation(fields: [item_id], references: [id], onDelete: Cascade)
  title        String
  status       String    @default("Belum") // Belum | Proses | Selesai | Tidak Berlaku
  pic_mp_id    Int?
  pic          ManPower? @relation("ChecklistPIC", fields: [pic_mp_id], references: [id])
  notes        String?
  completed_at DateTime?
  order_seq    Int       @default(0)

  @@schema("public")
}

model WorkItemReview {
  id          Int      @id @default(autoincrement())
  item_id     Int
  item        WorkItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  reviewer_id Int
  reviewer    User     @relation("ItemReviewer", fields: [reviewer_id], references: [id])
  decision    String // Approved | Revision
  notes       String?
  reviewed_at DateTime @default(now())

  @@schema("public")
}

model Sertifikasi {
  id                  Int       @id @default(autoincrement())
  man_power_id        Int
  man_power           ManPower  @relation(fields: [man_power_id], references: [id], onDelete: Cascade)
  nama_sertifikat     String // Certificate
  no_sertifikat       String? // Certification No
  tanggal_sertifikasi DateTime? // Date of Certification
  tanggal_berakhir    DateTime? // Certification Expires
  remarks             String? // Remarks
  is_rencana          Boolean   @default(false)
  is_ignored_expired  Boolean   @default(false)
  status              String    @default("Approved") // "Approved", "Pending Update", "Pending New"
  pending_changes     Json?
  proposed_by_id      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model PerformanceKiller {
  id            Int      @id @default(autoincrement())
  item          String
  area_plant    String
  masalah       String
  tindak_lanjut String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@schema("public")
}

// ============================================================
// Daily Task & Man Hours
// ============================================================

model DailyTask {
  id                  Int       @id @default(autoincrement())
  tanggal             DateTime
  code_referensi      String?
  man_power_id        Int?
  man_power           ManPower? @relation(fields: [man_power_id], references: [id])
  pabrik_id           Int?
  pabrik              Pabrik?   @relation(fields: [pabrik_id], references: [id])
  area                String?
  equipment           String?
  kategori_program    String
  deskripsi_pekerjaan String
  status              String    @default("Unassigned")
  wo_notif            String?
  waktu_mulai         DateTime?
  waktu_selesai       DateTime?
  man_hours           Float?
  created_by_id       Int?
  created_by          User?     @relation(fields: [created_by_id], references: [id])
  is_self_input       Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  task_logs           TaskLog[]

  @@schema("public")
}

model TaskLog {
  id                  Int       @id @default(autoincrement())
  daily_task_id       Int
  daily_task          DailyTask @relation(fields: [daily_task_id], references: [id], onDelete: Cascade)
  man_power_id        Int
  man_power           ManPower  @relation(fields: [man_power_id], references: [id])
  tanggal             DateTime
  waktu_mulai         DateTime
  waktu_selesai       DateTime?
  man_hours           Float
  deskripsi_aktivitas String?
  createdAt           DateTime  @default(now())

  @@schema("public")
}

// ============================================================
// Field Task (Program Pekerjaan Lapangan)
// ============================================================

model FieldTask {
  id                  Int             @id @default(autoincrement())
  judul               String
  deskripsi           String?
  pabrik_id           Int?
  pabrik              Pabrik?         @relation(fields: [pabrik_id], references: [id])
  area                String?
  equipment           String?
  wo_notif            String?
  kategori            String          @default("Corrective")
  prioritas           String          @default("Normal")
  status              String          @default("Open")
  
  pic_id              Int?
  pic                 ManPower?       @relation("FieldTaskPIC", fields: [pic_id], references: [id])
  
  created_by_id       Int?
  created_by          User?           @relation(fields: [created_by_id], references: [id])
  
  deadline            DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  
  members             FieldTaskMember[]
  logs                FieldTaskLog[]

  @@schema("public")
}

model FieldTaskMember {
  id              Int       @id @default(autoincrement())
  field_task_id   Int
  field_task      FieldTask @relation(fields: [field_task_id], references: [id], onDelete: Cascade)
  man_power_id    Int
  man_power       ManPower  @relation(fields: [man_power_id], references: [id])
  role            String    @default("MEMBER")
  added_at        DateTime  @default(now())

  @@unique([field_task_id, man_power_id])
  @@schema("public")
}

model FieldTaskLog {
  id              Int       @id @default(autoincrement())
  field_task_id   Int
  field_task      FieldTask @relation(fields: [field_task_id], references: [id], onDelete: Cascade)
  man_power_id    Int
  man_power       ManPower  @relation(fields: [man_power_id], references: [id])
  
  catatan         String
  status_update   String?
  
  tanggal         DateTime  @default(now())
  waktu_mulai     DateTime?
  waktu_selesai   DateTime?
  man_hours       Float?
  
  daily_task_id   Int?      // Nullable, if this log generated a daily task entry
  
  foto            String?   // Uploaded photo URL/path
  
  createdAt       DateTime  @default(now())

  @@schema("public")
}

// ============================================================
// PdM Rotating Schedule & Task Assignment
// ============================================================

enum EquipmentCategory {
  ROTATING
  STATIC
  GTG
  STG

  @@schema("public")
}

enum Criticality {
  CRITICAL
  NON_CRITICAL
  NA

  @@schema("public")
}

enum RecurrencePattern {
  MONTHLY_ONCE // 1x/bulan, tanggal tetap
  MONTHLY_TWICE // 2x/bulan, dua tanggal tetap
  TENTATIVE // tidak auto-generate, dibuat manual

  @@schema("public")
}

enum JobStatus {
  SCHEDULED // belum ada PIC, perlu di-claim manual
  ASSIGNED // sudah auto-assign ke PIC, belum mulai
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  OVERDUE // belum selesai, sudah lewat scheduledDate
  CANCELLED // dibatalkan

  @@schema("public")
}

model PdmScheduleRule {
  id                         Int                     @id @default(autoincrement())
  code                       String                  @unique
  pabrik_id                  Int
  pabrik                     Pabrik                  @relation(fields: [pabrik_id], references: [id])
  subArea                    String?
  equipmentCat               EquipmentCategory
  criticality                Criticality
  taskName                   String
  recurrence                 RecurrencePattern
  dateFirst                  Int?
  dateSecond                 Int?
  defaultPicId               Int?
  defaultPic                 ManPower?               @relation("RuleDefaultPic", fields: [defaultPicId], references: [id])
  defaultPicIds              Int[]
  defaultDataCollectorIds    Int[]
  defaultGtgDataCollectorIds Int[]
  isActive                   Boolean                 @default(true)
  notes                      String?
  occurrences                PdmScheduleOccurrence[]
  monthlyPicOverrides        PdmRuleMonthlyPic[]

  @@schema("public")
}

model PdmRuleMonthlyPic {
  id                  Int             @id @default(autoincrement())
  ruleId              Int
  rule                PdmScheduleRule @relation(fields: [ruleId], references: [id])
  year                Int
  month               Int
  picId               Int?
  pic                 ManPower?       @relation("MonthlyPicOverride", fields: [picId], references: [id])
  picIds              Int[]
  dataCollectorIds    Int[]
  gtgDataCollectorIds Int[]

  @@unique([ruleId, year, month])
  @@schema("public")
}

enum WorkflowStage {
  DC_COLLECTION // Stage 1: Data Collector mengumpulkan data
  ANALYSIS // Stage 2: Analyst menganalisis data
  AVP_APPROVAL // Stage 3: AVP menyetujui hasil analisis
  SAP_UPLOAD // Stage 4: DC upload data ke SAP
  CLOSED // Selesai semua tahap

  @@schema("public")
}

model PdmScheduleOccurrence {
  id     Int             @id @default(autoincrement())
  ruleId Int
  rule   PdmScheduleRule @relation(fields: [ruleId], references: [id])

  // Tanggal
  targetDate    DateTime // Tanggal asli dari master rule (tidak berubah)
  scheduledDate DateTime // Tanggal setelah shift hari libur
  actualDate    DateTime? // Tanggal task benar-benar dikerjakan
  wasShifted    Boolean   @default(false)
  year          Int // untuk query filter bulanan
  month         Int // untuk query filter bulanan

  status       JobStatus @default(SCHEDULED)
  isOverdue    Boolean   @default(false)
  cancelReason String?

  // 4-Stage Workflow
  workflowStage   WorkflowStage @default(DC_COLLECTION)
  dataCollectorId Int? // Stage 1: siapa DC yang bertugas
  dataCollector   ManPower?     @relation("OccurrenceDC", fields: [dataCollectorId], references: [id])
  analystId       Int? // Stage 2: siapa Analyst yang bertugas
  analyst         ManPower?     @relation("OccurrenceAnalyst", fields: [analystId], references: [id])
  avpId           Int? // Stage 3: siapa AVP yang ditugaskan
  avp             ManPower?     @relation("OccurrenceAVP", fields: [avpId], references: [id])

  // Stage Timestamps
  dcStartedAt        DateTime?
  dcFinishedAt       DateTime?
  analysisStartedAt  DateTime?
  analysisFinishedAt DateTime?
  avpActionAt        DateTime?
  sapUploadedAt      DateTime?

  // Hold tracking untuk man-hours calculation
  totalHoldMinutes Int @default(0) // Akumulasi semua hold duration (menit)

  // AVP Rejection
  avpRejectedReason String?

  // PIC Assignment (legacy — Analyst utama)
  assignedToId    Int?
  assignedTo      ManPower? @relation("AssignedTo", fields: [assignedToId], references: [id])
  originalPicId   Int? // snapshot PIC awal saat generate, untuk audit
  originalPicName String? // snapshot nama PIC awal

  // Timestamps
  claimedAt   DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  dailyActivities  PdmDailyActivity[]
  picHistories     PdmPicHistory[]
  workflowLogs     PdmWorkflowLog[]
  crossDelegations PdmCrossDelegation[]
  helpers          PdmOccurrenceHelper[]

  @@unique([ruleId, targetDate])
  @@schema("public")
}

model PdmOccurrenceHelper {
  id           Int                   @id @default(autoincrement())
  occurrenceId Int
  occurrence   PdmScheduleOccurrence @relation(fields: [occurrenceId], references: [id])

  manPowerId Int
  manPower   ManPower @relation(fields: [manPowerId], references: [id])

  stage       String // 'DC_COLLECTION' atau 'ANALYSIS'
  isCrossArea Boolean @default(false)
  status      String // 'APPROVED', 'PENDING', 'REJECTED'

  createdAt DateTime @default(now())

  @@unique([occurrenceId, manPowerId, stage])
  @@schema("public")
}

model PdmDailyActivity {
  id              Int                   @id @default(autoincrement())
  occurrenceId    Int
  occurrence      PdmScheduleOccurrence @relation(fields: [occurrenceId], references: [id])
  workDate        DateTime
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int?
  activityNote    String?
  statusSnapshot  JobStatus
  workflowStage   WorkflowStage? // Stage saat aktivitas terjadi
  performedById   Int?
  performedBy     ManPower?             @relation("DailyActivityPerformer", fields: [performedById], references: [id])

  @@schema("public")
}

// Histori setiap perubahan PIC per occurrence
model PdmPicHistory {
  id           Int                   @id @default(autoincrement())
  occurrenceId Int
  occurrence   PdmScheduleOccurrence @relation(fields: [occurrenceId], references: [id])
  fromPicId    Int?
  fromPic      ManPower?             @relation("PicHistoryFrom", fields: [fromPicId], references: [id])
  toPicId      Int
  toPic        ManPower              @relation("PicHistoryTo", fields: [toPicId], references: [id])
  reason       String
  changedById  Int
  changedBy    ManPower              @relation("PicHistoryChangedBy", fields: [changedById], references: [id])
  changedAt    DateTime              @default(now())

  @@schema("public")
}

// Audit log per perubahan stage workflow
model PdmWorkflowLog {
  id           Int                   @id @default(autoincrement())
  occurrenceId Int
  occurrence   PdmScheduleOccurrence @relation(fields: [occurrenceId], references: [id])
  fromStage    WorkflowStage?
  toStage      WorkflowStage
  action       String // 'DC_FINISH', 'ANALYSIS_FINISH', 'AVP_APPROVE', 'AVP_REJECT', 'SAP_UPLOAD', 'HOLD', 'RESUME'
  actorId      Int?
  actor        ManPower?             @relation("WorkflowLogActor", fields: [actorId], references: [id])
  notes        String?
  createdAt    DateTime              @default(now())

  @@schema("public")
}

// ============================================================
// DELEGASI CROSS-AREA — Analyst/AVP bisa assign personel dari area lain
// ============================================================

model PdmCrossDelegation {
  id            Int                   @id @default(autoincrement())
  occurrenceId  Int
  occurrence    PdmScheduleOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  delegatedById Int // Analyst/AVP yang memberi delegasi
  delegatedBy   ManPower              @relation("DelegationGranter", fields: [delegatedById], references: [id])
  delegatedToId Int // Personel penerima (boleh dari area berbeda)
  delegatedTo   ManPower              @relation("DelegationReceiver", fields: [delegatedToId], references: [id])
  role          String // 'DC' | 'ANALYST' | 'OBSERVER' — peran delegasi
  isActive      Boolean               @default(true)
  reason        String?
  expiresAt     DateTime? // null = tidak expired, otomatis hapus ketika task selesai
  createdAt     DateTime              @default(now())

  @@schema("public")
}
